<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/auth_spacing_large"
    android:background="?android:attr/windowBackground"
    tools:context=".presentation.view.LoginFragment">

    <TextView
        android:id="@+id/auth_tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/auth_margin_top_title"
        android:text="@string/auth_login_title"
        android:textSize="@dimen/auth_text_size_title"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:letterSpacing="0.15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/auth_container_form"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="@dimen/auth_spacing_large"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_til_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auth_spacing_medium"
            android:hint="@string/auth_login_user_hint"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            app:hintTextColor="?attr/colorPrimary"
            app:boxStrokeColor="?attr/colorPrimary"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxBackgroundMode="filled"
            app:startIconTint="?attr/colorOnSurfaceVariant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_et_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:inputType="text"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/auth_til_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auth_spacing_medium"
            android:hint="@string/auth_login_password_hint"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            app:hintTextColor="?attr/colorPrimary"
            app:boxStrokeColor="?attr/colorPrimary"
            app:boxBackgroundColor="?attr/colorSurfaceVariant"
            app:boxBackgroundMode="filled"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="?attr/colorOnSurfaceVariant"
            app:startIconTint="?attr/colorOnSurfaceVariant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/auth_et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/auth_switch_remember_me"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/auth_spacing_large"
            android:text="@string/auth_login_remember_me_label"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/auth_text_size_small"
            app:thumbTint="?attr/colorPrimary"
            app:trackTint="?attr/colorSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/auth_btn_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/auth_button_height"
            android:text="@string/auth_login_button_label"
            android:textSize="@dimen/auth_text_size_medium"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="@dimen/auth_button_corner_radius" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/auth_progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="?attr/colorPrimary"
        android:contentDescription="@string/auth_loading_cd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>